           <property name="styleSheet">
            <string notr="true">QPushButton { background-color: #f4c7c3; color: black; } QPushButton:disabled { background-color: #ebe3e2; color: #888888; }</string>
           </property>
           <property name="text">
            <string>Reset selected specimen...</string>
           </property>
