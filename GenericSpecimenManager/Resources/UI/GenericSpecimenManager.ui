      <item>
       <widget class="QPushButton" name="btnSaveDB">
        <property name="toolTip">
         <string>Write the live database table (including any status edits) back to its CSV file.</string>
        </property>
        <property name="text">
         <string> Save database CSV</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnBatchExport">
        <property name="toolTip">
         <string>Runs cfg.batch_export against every 'finished' specimen: exports segments/markups to files and/or computes custom per-segment statistics into one combined CSV, depending on what's enabled in the Config Editor's General tab.</string>
        </property>
        <property name="text">
         <string>Batch Export</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
